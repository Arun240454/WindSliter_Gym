# Copy this file to ".env" and fill in your values.
# The .env file stays on your computer: keep it private and never share or commit it.

# Your OpenAI secret key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Chat model (gpt-4o-mini is fast and inexpensive)
OPENAI_MODEL=gpt-4o-mini

# Password for the customer-message inbox at /admin (username: admin)
IRONPEAK_ADMIN_PASSWORD=ironpeak
